{
    "name": "gauss-kruger",
    "version": "1.0.0",
    "description": "Typed Gauss–Krüger (Transverse Mercator) forward/inverse projection utilities",
    "keywords": [
        "gauss-kruger",
        "gausskruger",
        "transverse-mercator",
        "projection",
        "geodesy",
        "mapping",
        "utm",
        "mga2020",
        "coordinates",
        "typescript"
    ],
    "author": "Your Name <your.email@example.com>",
    "license": "MIT",
    "type": "module",
    "main": "dist-cjs/index.js",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist-cjs/index.js"
        }
    },
    "files": [
        "dist",
        "dist-cjs",
        "README.md",
        "LICENSE"
    ],
    "sideEffects": false,
    "repository": {
        "type": "git",
        "url": "https://github.com/canetoad/graussKruger.git"
    },
    "bugs": {
        "url": "https://github.com/canetoad/graussKruger/issues"
    },
    "homepage": "https://github.com/canetoad/graussKruger#readme",
    "scripts": {
        "build": "npm run clean && npm run build:esm && npm run build:cjs && node scripts/create-cjs-package.mjs",
        "build:esm": "tsc -p tsconfig.json",
        "build:cjs": "tsc -p tsconfig.cjs.json",
        "clean": "rimraf dist dist-cjs",
        "dev": "tsc -p tsconfig.json --watch",
        "test": "npm run build && npm run test:smoke",
        "test:smoke": "node --test test/smoke.test.js",
        "test:watch": "npm run build && node --test --watch test/smoke.test.js",
        "lint": "tsc --noEmit -p tsconfig.json",
        "format": "prettier --write .",
        "example:mga2020": "ts-node --esm examples/mag2020.ts",
        "example:utm": "ts-node --esm examples/utm.ts",
        "prepublishOnly": "npm run test && npm run lint",
        "preversion": "npm run test && npm run lint",
        "version": "npm run build",
        "postversion": "git push && git push --tags"
    },
    "engines": {
        "node": ">=18"
    },
    "devDependencies": {
        "@types/node": "^22.9.0",
        "prettier": "^3.3.3",
        "rimraf": "^6.0.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.6.3"
    }
}
